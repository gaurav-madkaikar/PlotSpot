# Copy to .env in this directory. Never put credentials in frontend variables.
MOVIE_DATA_SOURCE=demo
# For live mode, set MOVIE_DATA_SOURCE=tmdb and add your API Read Access Token.
TMDB_READ_TOKEN=

# Local account sessions. For an HTTPS deployment, set the exact public origin
# and FRAME_SECURE_COOKIES=true. HTTP is allowed only for loopback development.
FRAME_APP_ORIGIN=http://127.0.0.1:5173
FRAME_SECURE_COOKIES=false
# Optional private SQLite location; omitted uses backend/data/private/accounts.
# FRAME_ACCOUNT_DB=/absolute/private/path/accounts.db

# Explicit local development preview. No real email is delivered in preview mode.
# Must use loopback HTTP. Public deployments use smtp with TLS; default disabled.
PLOTSPOT_VERIFICATION_MODE=preview
# PLOTSPOT_SMTP_HOST=smtp.example.com
# PLOTSPOT_SMTP_PORT=587
# PLOTSPOT_SMTP_TLS=starttls
# PLOTSPOT_SMTP_FROM=your-verified-sender@example.com
# PLOTSPOT_SMTP_USERNAME=
# PLOTSPOT_SMTP_PASSWORD=

# Optional trusted moderation role: comma-separated existing account UUIDs.
# IDs come from the operator's private account records, never a client role field.
# PLOTSPOT_MODERATOR_IDS=

# Shared movie evidence discovery, free/no API key. Off for offline fixtures.
# Alternative: startpage. Provider blocks return explicit reduced coverage.
PLOTSPOT_MOVIE_WEB_SEARCH=duckduckgo
# Optional immutable corpus database location:
# PLOTSPOT_WEB_CORPUS_DB=/absolute/private/path/web-corpus.db
